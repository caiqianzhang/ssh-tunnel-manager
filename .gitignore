# Build artifacts (the Makefile writes them to build/, but a plain
# `go build .` in the root still drops them here — ignore both).
build/
ssh-tunnel-manager
ssh-tunnel-manager-linux
ssh-tunnel-manager.exe

# Runtime files (generated, never commit)
ssh-tunnel-manager.log
secret.key
config.json

# Baidu Cloud DNS credentials (AK/SK) — keep local, never commit
baidu.key

# Vendored third-party deps are tracked (see third_party/),
# but build cache and module downloads are not.
/vendor/

# Editor / OS
.DS_Store
*.swp